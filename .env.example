# BuyWise Amazon Associates & Netlify Production Deployment Configuration
# Copy this file to .env or configure in Netlify Dashboard: Site configuration > Environment variables

# Amazon Associates Tracking ID (e.g., yourtag-21 for Amazon.in or yourtag-20 for Amazon.com)
VITE_AMAZON_AFFILIATE_TAG=your_affiliate_tag_here

# Base Amazon Marketplace URL (default: https://www.amazon.in)
VITE_AMAZON_BASE_URL=https://www.amazon.in

# Production Site URL (used for canonical URLs, sitemap, and Open Graph tags)
VITE_SITE_URL=https://your-site.netlify.app
